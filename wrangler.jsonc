{
  // Cloudflare Workers static-assets deploy. `node scripts/build.mjs` pre-renders site/ into dist/ (one real HTML file per page,
  // sitemap.xml, robots.txt, _redirects, 404.html) and wrangler publishes dist/. No npm dependencies are needed for the build.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "hadadi",
  "compatibility_date": "2026-10-01",
  // worker/index.js only handles /dl/* (audio downloads from R2 under the lesson's title), /health (uptime monitor) and /bot (the
  // announcements bot's Telegram webhook, worker/bot.js); everything else is dist/.
  "main": "worker/index.js",
  "build": {
    "command": "node scripts/build.mjs"
  },
  "assets": {
    "directory": "./dist",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
    "binding": "ASSETS",
    "run_worker_first": ["/dl/*", "/health", "/bot", "/api/contact", "/api/event", "/api/published", "/api/sync-report", "/api/posters", "/ann/*", "/admin", "/admin/*", "/"]
  },
  // Workers Logs (free plan: 200,000 log lines a day, kept 3 days): the bot's and the timer's errors show under Observability.
  "observability": { "enabled": true },
  "r2_buckets": [{ "binding": "MEDIA", "bucket_name": "hadadi-media" }],
  // D1 (owner created 2026-11-19): «تواصل معنا» messages now, the admin portal later. The id is not a secret.
  "d1_databases": [{ "binding": "DB", "database_name": "hadadi", "database_id": "dc0c99fe-4f8b-4c06-ade6-87b3af72a170", "migrations_dir": "db/migrations" }],
  // Email Workers: worker/contact.js mails each message. It can only reach a VERIFIED destination address of Email Routing,
  // so it sends to the variable MAIL_TO (the team inbox, set in the dashboard, not committed) and falls back to info@h-haddadi.com.
  "send_email": [{ "name": "MAIL" }],
  // Publish (worker/admin/publish.mjs): the secret DEPLOY_HOOK = this Worker's Workers Builds deploy hook URL (Settings > Builds >
  // Deploy Hooks, branch main). Set it with «Add variable > Secret» in the dashboard; never commit it.
  // Admin portal on admin.h-haddadi.com (custom domain on this Worker; worker/admin/). Cloudflare Access application «hadadi-admin»:
  // the team domain and its AUD tag are not secrets; the portal checks both on every request.
  "vars": {
    "ACCESS_TEAM_DOMAIN": "mojed.cloudflareaccess.com",
    "ACCESS_AUD": "34547c77501d7ab864819a11a76bba6d6be833e80c43039835ef2bf0781c33be"
  },
  // Timer (UTC): 21:07 = 00:07 Riyadh, posters whose end date passed leave the site (EXPIRE_CRON in worker/index.js).
  "triggers": { "crons": ["7 21 * * *"] },
  // Branch previews (Workers Builds runs `npx wrangler preview` for non-production branches); empty = same settings as production.
  "previews": {}
}
